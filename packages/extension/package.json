{
  "name": "no-longer-vibe",
  "displayName": "No Longer Vibe",
  "description": "Deterministic codebase comprehension tool — read your AI-generated codebase in smart order with progress tracking.",
  "version": "0.1.0",
  "publisher": "no-longer-vibe",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.codebase-guide/map.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nlv-sidebar",
          "title": "No Longer Vibe",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "nlv-sidebar": [
        {
          "id": "nlv.progressTree",
          "name": "Reading Progress",
          "type": "tree"
        }
      ]
    },
    "colors": [
      {
        "id": "noLongerVibe.confirmed",
        "description": "Color for files that have been read and understood",
        "defaults": {
          "light": "#2e7d32",
          "dark": "#66bb6a",
          "highContrast": "#66bb6a"
        }
      },
      {
        "id": "noLongerVibe.flagged",
        "description": "Color for files flagged for a second pass",
        "defaults": {
          "light": "#e65100",
          "dark": "#ffa726",
          "highContrast": "#ffa726"
        }
      },
      {
        "id": "noLongerVibe.current",
        "description": "Color for the file currently being read",
        "defaults": {
          "light": "#1565c0",
          "dark": "#42a5f5",
          "highContrast": "#42a5f5"
        }
      },
      {
        "id": "noLongerVibe.skimmed",
        "description": "Color for files that were skimmed and need deeper review",
        "defaults": {
          "light": "#7e57c2",
          "dark": "#b39ddb",
          "highContrast": "#b39ddb"
        }
      }
    ]
  },
  "scripts": {
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "lint": "eslint src/ test/ --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepackage": "npm run build",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
